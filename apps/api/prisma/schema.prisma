generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  passwordHash      String
  firstName         String
  lastName          String
  phone             String?
  role              UserRole           @default(CUSTOMER)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  aiSessions        AiSession[]
  bookings          Booking[]
  reviews           Review[]
  serviceRecords    ServiceRecord[]
  serviceRequests   ServiceRequest[]
  specialistProfile SpecialistProfile?
  vehicles          Vehicle[]
}

model Vehicle {
  id              String           @id @default(uuid())
  userId          String
  make            String
  model           String
  year            Int
  vin             String?          @unique
  registrationNo  String?
  mileage         Int?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  aiSessions      AiSession[]
  bookings        Booking[]
  serviceRecords  ServiceRecord[]
  serviceRequests ServiceRequest[]
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SpecialistProfile {
  id           String    @id @default(uuid())
  userId       String    @unique
  businessName String?
  description  String?
  phone        String?
  address      String?
  city         String?
  latitude     Float?
  longitude    Float?
  verified     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  bookings     Booking[]
  quotes       Quote[]
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AiSession {
  id        String          @id @default(uuid())
  userId    String
  vehicleId String
  status    AiSessionStatus @default(ACTIVE)
  symptoms  String?
  diagnosis String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  messages  AiMessage[]
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle   Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([vehicleId])
}

model AiMessage {
  id        String    @id @default(uuid())
  sessionId String
  role      String
  content   String
  createdAt DateTime  @default(now())
  session   AiSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model ServiceRequest {
  id            String               @id @default(uuid())
  userId        String
  vehicleId     String
  title         String
  description   String
  status        ServiceRequestStatus @default(OPEN)
  location      String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  booking       Booking?
  quotes        Quote[]
  serviceRecord ServiceRecord?
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle       Vehicle              @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([vehicleId])
  @@index([status])
}

model Quote {
  id               String            @id @default(uuid())
  serviceRequestId String
  specialistId     String
  amount           Decimal
  description      String?
  status           QuoteStatus       @default(PENDING)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  booking          Booking?
  serviceRequest   ServiceRequest    @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  specialist       SpecialistProfile @relation(fields: [specialistId], references: [id], onDelete: Cascade)

  @@index([serviceRequestId])
  @@index([specialistId])
}

model Booking {
  id               String            @id @default(uuid())
  userId           String
  vehicleId        String
  serviceRequestId String            @unique
  quoteId          String            @unique
  specialistId     String
  scheduledAt      DateTime?
  status           BookingStatus     @default(PENDING)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  quote            Quote             @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  serviceRequest   ServiceRequest    @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  specialist       SpecialistProfile @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle          Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  job              Job?
}

model Job {
  id          String    @id @default(uuid())
  bookingId   String    @unique
  status      JobStatus @default(SCHEDULED)
  startedAt   DateTime?
  completedAt DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  booking     Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model ServiceRecord {
  id               String         @id @default(uuid())
  userId           String
  vehicleId        String
  serviceRequestId String         @unique
  serviceType      String
  description      String?
  cost             Decimal?
  servicedAt       DateTime       @default(now())
  createdAt        DateTime       @default(now())
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle          Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([vehicleId])
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum UserRole {
  CUSTOMER
  SPECIALIST
  ADMIN
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
}

enum ServiceRequestStatus {
  OPEN
  QUOTING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum QuoteStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum JobStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AiSessionStatus {
  ACTIVE
  COMPLETED
  FAILED
}
